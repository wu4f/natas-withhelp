PHP script

function xor_encrypt($in,$out) {
    $key = $out;
    $text = $in;
    $outText = '';

    // Iterate through each character
    for($i=0;$i<strlen($text);$i++) {
    $outText .= $text[$i] ^ $key[$i % strlen($key)];
    }

    return $outText;
}
echo 'Hello World';
$defaultdata = array( "showpassword"=>"no", "bgcolor"=>"#ffffff");
$attackdata = array( "showpassword"=>"yes", "bgcolor"=>"#ffffff");

$x = json_encode($defaultdata);
$y = base64_decode("ClVLIh4ASCsCBE8lAxMacFMZV2hdVVotEhhUJQNVAmhSEV4sFxFeaAw=");
$z = xor_encrypt($x,$y);
$done = xor_encrypt(json_encode($attackdata), "qw8J");
echo "$z\n";
$reallydone = base64_encode($done);
echo $reallydone;

